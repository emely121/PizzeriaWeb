@model List<PizzeriaWeb.Models.VwMenuUsuario>

@foreach (var modulo in Model.GroupBy(m => new { m.ModuloId, m.Modulo }))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark" href="#" role="button"
           data-bs-toggle="dropdown" aria-expanded="false">@modulo.Key.Modulo</a>
        <ul class="dropdown-menu">
            @foreach (var submenu in modulo)
            {
                <li><a class="dropdown-item" href="@submenu.Ruta">@submenu.Submenu</a></li>
            }
        </ul>
    </li>
}
