@model PizzeriaWeb.ViewModels.ProductoCatalogoItem

<div class="col">
    <div class="card h-100 shadow-sm">
        @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" class="card-img-top" alt="@Model.Nombre" style="height:180px;object-fit:cover" />
        }
        else
        {
            <div class="d-flex align-items-center justify-content-center bg-light" style="height:180px;font-size:4rem">🍕</div>
        }
        <div class="card-body d-flex flex-column">
            <span class="badge text-bg-secondary align-self-start mb-2">@Model.Categoria</span>
            <h3 class="h5 card-title">@Model.Nombre</h3>
            <p class="card-text text-muted small flex-grow-1">@Model.Descripcion</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold fs-5">C$ @Model.Precio.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</span>
                @if (Model.UnidadesVendidas is > 0)
                {
                    <span class="small text-muted">@Model.UnidadesVendidas vendidos</span>
                }
            </div>
        </div>
    </div>
</div>
